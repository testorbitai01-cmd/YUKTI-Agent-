{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "common/**/*.ts"],
  "exclude": ["server/test/**"]
}
