# ─────────────────────────────────────────────────────────────
# YUKTI Agent — environment template. Copy to `.env` (this folder). NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# NODE_ENV is deliberately not set here: Vite reads this file, and NODE_ENV=development would make
# `npm run build` bundle React's development build. The server defaults to development; set
# NODE_ENV=production as a deployment variable (Railway).
PORT=3002

# Base URL of the Test Orbit app (its /api). Every tool call runs against this API as the
# signed-in admin, so Test Orbit's roles, validation, row locks and audit log all apply.
#   Local:      http://localhost:4000
#   Production: https://<your-test-orbit-domain>
TESTORBIT_API_URL=http://localhost:4000

# Public origin of YUKTI itself (CSRF/Origin checks). Dev UI runs on Vite :5174.
APP_ORIGIN=http://localhost:5174

# MCP endpoint the agent engine calls. Default: this server's own /mcp (recommended).
# Only point it at a YUKTI-compatible MCP server you trust: it receives operators' session tokens.
# MCP_BASE_URL=http://127.0.0.1:3002

# Number of trusted reverse-proxy hops (Railway = 1).
TRUST_PROXY=0
